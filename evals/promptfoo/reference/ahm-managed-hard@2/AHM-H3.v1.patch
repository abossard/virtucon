@@ -0,0 +1,67 @@
+// Read-only freshness check: what `--sync-markdown` would produce versus what exists now.
+import { join, resolve } from "node:path";
+import { prepareDocuments } from "./document.mjs";
+import { renderSwimlane } from "./swimlane.mjs";
+import { getTheme } from "./themes.mjs";
+import { Diagnostics } from "./diag.mjs";
+import { syncMarkdown, svgHref } from "./markdown-sync.mjs";
+
+const RANK = { current: 0, drift: 1, error: 2 };
+
+function checkBlock(b, { name, outDir, imageFormat, readSvg, strict }) {
+  const diagnostics = b.issues.map((i) => ({ level: i.level, message: i.message, line: i.line ?? null, slug: b.slug }));
+  const path = join(outDir, `${b.slug}.svg`);
+  const fail = (message) => {
+    diagnostics.push({ level: "error", message, line: b.line, slug: b.slug });
+    return { artifact: { slug: b.slug, path, status: "error" }, diagnostics };
+  };
+  if (diagnostics.some((d) => d.level === "error")) return fail("block has errors");
+  if (b.renderer !== "swimlane") return fail(`unsupported check: renderer "${b.renderer}" cannot be verified without a browser or mermaid-cli`);
+  let expected;
+  try {
+    const diag = new Diagnostics({ file: name });
+    const o = b.effectiveOptions;
+    expected = renderSwimlane(b.code, {
+      theme: getTheme(o.theme), title: o.title, subtitle: o.subtitle, lanes: o.lanes,
+      legend: o.legend, laneLabels: o.laneLabels, diag, baseLine: b.codeLine - 1,
+    }).svg;
+    for (const i of diag.items) if (i.level !== "info") diagnostics.push({ level: i.level, message: i.message, line: i.line, slug: b.slug });
+  } catch (e) { return fail(`render failed: ${e.message}`); }
+  if (strict && diagnostics.some((d) => d.level === "warn")) {
+    for (const d of diagnostics) if (d.level === "warn") d.level = "error";
+    return { artifact: { slug: b.slug, path, status: "error" }, diagnostics };
+  }
+  let actual;
+  try { actual = readSvg(path); }
+  catch (e) { return fail(`cannot read ${path}: ${e.message}`); }
+  const status = actual == null ? "missing" : actual === expected ? "current" : "stale";
+  return { artifact: { slug: b.slug, path, status }, diagnostics, spec: { slug: b.slug, openLine: b.line, closeLine: b.closeLine, title: b.effectiveOptions.title, alt: b.options.alt, href: svgHref(name, path, imageFormat) } };
+}
+
+export function checkMarkdownSync(inputs, { outDir = "diagrams", imageFormat = "commonmark", theme = "portal", renderer = "auto", readSvg, strict = false } = {}) {
+  const absOut = resolve(outDir);
+  const prepared = prepareDocuments(inputs, { theme, renderer }, { sync: true });
+  const documents = prepared.map((doc) => {
+    const diagnostics = doc.diagnostics.map((d) => ({ level: d.level, message: d.message, line: d.line ?? null }));
+    if (diagnostics.length) return { name: doc.name, markdownStatus: "error", artifacts: [], diagnostics };
+    const artifacts = [], specs = [];
+    for (const b of doc.blocks) {
+      const r = checkBlock(b, { name: doc.name, outDir: absOut, imageFormat, readSvg, strict });
+      artifacts.push(r.artifact);
+      diagnostics.push(...r.diagnostics);
+      if (r.spec) specs.push(r.spec);
+    }
+    const hasError = artifacts.some((a) => a.status === "error");
+    let markdownStatus = "current";
+    if (hasError) markdownStatus = "error";
+    else if (doc.blocks.length > 0 && syncMarkdown(doc.markdown, specs, { imageFormat }) !== doc.source) markdownStatus = "stale";
+    return { name: doc.name, markdownStatus, artifacts, diagnostics };
+  });
+  let status = "current";
+  for (const d of documents) {
+    const own = d.markdownStatus === "error" || d.artifacts.some((a) => a.status === "error") ? "error"
+      : d.markdownStatus === "stale" || d.artifacts.some((a) => a.status !== "current") ? "drift" : "current";
+    if (RANK[own] > RANK[status]) status = own;
+  }
+  return { status, documents };
+}
