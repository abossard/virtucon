+// Machine-readable projection of prepareDocuments(): one calculation shared by the API and the CLI.
+import { prepareDocuments } from "./document.mjs";
+
+export function inventoryDocuments(inputs, defaults = {}) {
+  const documents = prepareDocuments(inputs, defaults).map((doc) => ({
+    name: doc.name,
+    blocks: doc.blocks.map((b) => ({
+      slug: b.slug,
+      line: b.line,
+      closeLine: b.closeLine,
+      location: b.location,
+      renderer: b.renderer,
+      effectiveOptions: b.effectiveOptions,
+      issues: b.issues,
+    })),
+    diagnostics: doc.diagnostics,
+  }));
+  return { schemaVersion: 1, documents };
+}
