@@ -0,0 +1,40 @@
+// Inverse of syncMarkdown(): replaces each managed span with its original Mermaid fence.
+import { decodeManagedSpans, validateManagedSpans, splitLines, joinLines } from "./managed-source.mjs";
+import { extractBlocks } from "./extract.mjs";
+
+function restoreWithSpans(source) {
+  const decoded = decodeManagedSpans(source);
+  const spans = validateManagedSpans(decoded);
+  if (spans.length === 0) return { restored: source, slugs: [] };
+  const { lines, eol, hadTrailingNewline } = splitLines(decoded);
+  const out = lines.slice();
+  for (const span of [...spans].reverse()) {
+    const inner = lines.slice(span.beginLine - 1, span.endLine).join("\n");
+    const [block] = extractBlocks(inner);
+    if (block.closeLine == null) {
+      throw new Error(`markdown-sync: managed span "${span.slug}" (lines ${span.beginLine}-${span.endLine}) has an unclosed mermaid fence — malformed managed block`);
+    }
+    const fence = lines.slice(span.beginLine - 1 + block.line - 1, span.beginLine - 1 + block.closeLine);
+    out.splice(span.beginLine - 1, span.endLine - span.beginLine + 1, ...fence);
+  }
+  return { restored: joinLines(out, eol, hadTrailingNewline), slugs: spans.map((s) => s.slug) };
+}
+
+export function restoreMarkdown(source) {
+  return restoreWithSpans(source).restored;
+}
+
+// Validates the whole batch (including cross-file slug identity) before returning any result.
+export function restoreDocuments(inputs) {
+  const owners = new Map();
+  return inputs.map(({ name, source }) => {
+    let result;
+    try { result = restoreWithSpans(source); }
+    catch (e) { throw new Error(`${name}: ${e.message}`); }
+    for (const slug of result.slugs) {
+      if (owners.has(slug)) throw new Error(`${name}: managed slug "${slug}" is already used by ${owners.get(slug)} — duplicate managed identity`);
+      owners.set(slug, name);
+    }
+    return { name, source, restored: result.restored, blocks: result.slugs.length };
+  });
+}
